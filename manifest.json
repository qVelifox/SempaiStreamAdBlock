{
  "manifest_version": 3,
  "name": "Sempai Stream NoAds",
  "version": "1.5.2",
  "description": "Automatically submit the ad gate validations before playback.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://senpai-stream.living/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://senpai-stream.living/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://senpai-stream.living/*"
      ],
      "js": [
        "gate.js",
        "observe.js",
        "flow.js",
        "toast.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
